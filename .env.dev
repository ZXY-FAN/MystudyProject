# 开发环境配置
FLASK_APP=app/main.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

MODEL_PATH=ml/registry/model.pkl
MODEL_TYPE=random_forest

MLFLOW_TRACKING_URI=file:///app/mlruns
MLFLOW_EXPERIMENT_NAME=classification_experiment_dev

APP_NAME=ml-devops-app
APP_VERSION=1.0.0
ENVIRONMENT=development

LOG_LEVEL=DEBUG
LOG_FILE=/app/logs/app_dev.log

DATA_SOURCE=synthetic
FEATURE_COUNT=4
MODEL_ACCURACY_THRESHOLD=0.80

SECRET_KEY=dev-secret-key-change-in-production
API_RATE_LIMIT=1000/hour

DOCKER_BUILD_DATE=2024-01-01
DOCKER_BUILD_VERSION=1.0-dev
