# =============================================
# Flask 应用配置
# =============================================

# Flask 应用设置
FLASK_APP=app/main.py
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# 应用安全设置
SECRET_KEY=your-production-secret-key-change-in-production
CSRF_ENABLED=True

# =============================================
# 模型和数据处理配置
# =============================================

# 模型路径配置
MODEL_PATH=/app/ml/registry/model.pkl
CONFIG_PATH=/app/ml/configs/training_config.yaml

# 数据预处理配置
DATA_TEST_SIZE=0.2
RANDOM_STATE=42
DATA_SOURCE=synthetic_generated

# 模型参数配置
MODEL_N_ESTIMATORS=100
MODEL_MAX_DEPTH=10

# =============================================
# MLflow 实验跟踪配置
# =============================================

# MLflow 设置
MLFLOW_TRACKING_URI=file:/app/ml/mlruns
MLFLOW_EXPERIMENT_NAME=classification_experiment

# 实验跟踪配置
MLFLOW_LOGGING_ENABLED=True
MLFLOW_AUTOLOG_ENABLED=True

# =============================================
# 测试和开发配置
# =============================================

# 测试配置
TESTING=False
PYTEST_ADDOPTS=--tb=short -v

# 开发工具配置
PYTHONPATH=/app
PYTHONUNBUFFERED=1

# =============================================
# 性能和安全配置
# =============================================

# 性能优化
WORKER_COUNT=4
THREADS_PER_WORKER=2

# 安全设置
MAX_CONTENT_LENGTH=16777216  # 16MB
JSON_SORT_KEYS=False

# =============================================
# 日志配置
# =============================================

# 日志级别
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# 日志文件
LOG_FILE=/app/logs/app.log
ERROR_LOG_FILE=/app/logs/error.log