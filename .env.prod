# 生产环境配置
FLASK_APP=app/main.py
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

MODEL_PATH=ml/registry/model.pkl
MODEL_TYPE=random_forest

# 生产环境可以使用远程 MLflow 服务器
# MLFLOW_TRACKING_URI=http://mlflow-server:5000
MLFLOW_TRACKING_URI=file:///app/mlruns
MLFLOW_EXPERIMENT_NAME=classification_experiment_prod

APP_NAME=ml-devops-app
APP_VERSION=1.0.0
ENVIRONMENT=production

LOG_LEVEL=INFO
LOG_FILE=/app/logs/app_prod.log

DATA_SOURCE=synthetic
FEATURE_COUNT=4
MODEL_ACCURACY_THRESHOLD=0.90

SECRET_KEY=change-this-to-a-secure-random-key-in-production
API_RATE_LIMIT=100/hour

DOCKER_BUILD_DATE=2024-01-01
DOCKER_BUILD_VERSION=1.0
